* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.m text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.stl binary
*.STL binary
*.docx binary
*.pdf binary
*.mp4 binary
*.npz binary
*.db binary

# Preserve verbatim historical/export text without treating its source
# whitespace as a new integration defect.
*.log whitespace=-trailing-space,-blank-at-eof
*.urdf whitespace=-trailing-space,-blank-at-eof
*.m whitespace=-trailing-space,-blank-at-eof
