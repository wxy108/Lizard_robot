* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.m text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.stl binary
*.STL binary
*.docx binary
*.pdf binary
*.mp4 binary
*.gif binary
*.png binary
*.npz binary
*.db binary

# Preserve verbatim historical/export text without treating its source
# whitespace as a new integration defect.
*.log whitespace=-trailing-space,-blank-at-eof
*.urdf whitespace=-trailing-space,-blank-at-eof
*.m whitespace=-trailing-space,-blank-at-eof

# Immutable upstream snapshot: retain original blob bytes on every platform.
third_party/RFT-SiM/** -text whitespace=-trailing-space,-blank-at-eof

# Preserve upstream license text hashes in the reviewed integration demo set.
docs/media/general_rft_stage1/LICENSE-*.txt text eol=lf
docs/media/ground_rft_pipeline/LICENSE-*.txt text eol=lf
controllers/NOTICE.playground text eol=lf
requirements-locomotion.txt text eol=lf
docs/regressions/2026-10-28-ground-rft/*.log text eol=lf
